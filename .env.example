# Neon Postgres (pooled for serverless)
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct (unpooled) — used by long-running scripts (seed)
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# 32+ char secret for signing admin JWTs and protecting cron endpoints
AUTH_SECRET="change-me-to-a-long-random-string-please-32+"

# Used as bearer token for /api/cron/* endpoints
CRON_SECRET="change-me-to-a-long-random-string-please-32+"

# Public base URL of the deployed site (used for QR generation + metadata)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"